      "connected_device": "DHT11",
      "type": "sensor",
      "protocol": "digital_1wire",
      "status": "available"
    },
    "GPIO_27": {
      "connected_device": "Relay_Fan",
      "type": "actuator",
      "active_level": "HIGH",
      "status": "dormant"
    },
    "GPIO_22": {
      "connected_device": "Lidar_X2",
      "type": "sensor",
      "protocol": "UART",
      "status": "dormant"
    }
  }
}
