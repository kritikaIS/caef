# Copy to .env and fill in. Every safety-relevant tunable lives here (TDD.md §6).

# --- Storage ---
# Supabase: Project Settings > Database > Connection string (URI), session pooler.
# Leave unset to fall back to local SQLite (offline tests / E2E).
# DATABASE_URL=postgresql+psycopg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# RAG_DB_PATH=caef_rag.db
#
# Tests default to in-memory SQLite. To run the same suite against Postgres —
# worth doing before a release, since the two backends differ on timezone
# handling and foreign-key enforcement:
#     CAEF_TEST_POSTGRES=1 pytest
# It uses the DATABASE_URL above but confines itself to a dedicated `caef_test`
# schema, and refuses to start if it ever finds itself pointed at `public`
# (the per-test fixture truncates every table).

# --- Agent (LangChain over any OpenAI-compatible endpoint) ---
LLM_API_KEY=
LLM_MODEL=gpt-4o
# OpenRouter: https://openrouter.ai/api/v1 | Groq: https://api.groq.com/openai/v1
# Ollama (free/local): http://localhost:11434/v1
# LLM_BASE_URL=

# --- Safety (defaults shown; override only with a documented reason) ---
# MAX_RETRIES=3
# SANDBOX_TIMEOUT_SECONDS=10
# STRIKE_LIMIT=3
# REVERSION_WINDOW_SECONDS=300
# REVERSION_MODE=time            # time | condition | combined  (PRD OQ-1)
# EXTRA_FORBIDDEN_PINS=

# --- Adaptation mode ---------------------------------------------------------
# source_generation  the preserved v0.1 baseline: the LLM writes a whole Python
#                    firmware file, vetted by Guard Rail + the Docker sandbox.
# manifest_compiler  RECOMMENDED. The LLM writes a declarative Behavior
#                    Manifest; deterministic components validate, compile,
#                    simulate and sign it, and an immutable on-device supervisor
#                    owns the actuators.
# The default is source_generation so an existing checkout is unchanged; the
# demo, the experiment harness and docker-compose all select manifest_compiler.
ADAPTATION_MODE=manifest_compiler

# --- Signed OTA (manifest_compiler) ------------------------------------------
# HMAC-SHA256 key shared by the server and the virtual device. Required whenever
# the two run in different processes. Generate one with:
#     python -c 'import secrets; print(secrets.token_hex(32))'
# Never commit a real key; this file is an example.
# CAEF_OTA_HMAC_KEY=

# --- Contract-constrained safety limits (defaults shown) ---------------------
# MAX_LEASE_SECONDS=900          # ceiling on any temporary morph's lease
# EMERGENCY_TEMP_C=95.0          # supervisor forces cooling at/above this
# CRITICAL_TEMP_C=100.0          # verifier's damage limit
# PROBATION_HEALTHY_TICKS=5      # healthy ticks before a candidate is activated
# LOCAL_FAILURE_LIMIT=3          # local crashes before a device self-reverts
# VERIFY_ACTIVATION_LATENCY_TICKS=2
# SIM_DEFAULT_SEED=20260827
